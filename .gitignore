# ============================================================
# General .gitignore for kimi-agent project
# ============================================================

# -----------------------------------------------------------
# macOS
# -----------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride

# -----------------------------------------------------------
# IDE / Editors
# -----------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# -----------------------------------------------------------
# Python
# -----------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
# The Windows installer output. build_windows.py defaults --output-dir to
# ../dist-win, i.e. here at the repo root; packaging/.gitignore listed it but
# a pattern there only matches inside packaging/, so a ~200 MB installer sat
# untracked at the root after every local Windows build.
dist-win/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# Virtual environments
venv/
ENV/
env/
.venv/

# -----------------------------------------------------------
# Node.js / Frontend
# -----------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo

# -----------------------------------------------------------
# Environment / Secrets
# -----------------------------------------------------------
.env
.env.local
.env.*.local
!.env.example
*.pem
*.key
secrets/

# -----------------------------------------------------------
# Docker
# -----------------------------------------------------------
docker-compose.override.yml

# -----------------------------------------------------------
# Logs
# -----------------------------------------------------------
logs/
*.log

# -----------------------------------------------------------
# Session / Runtime Data
# -----------------------------------------------------------
session-data/
*.session
*.pid

# -----------------------------------------------------------
# Test / Coverage
# -----------------------------------------------------------
coverage/
htmlcov/
.coverage

# -----------------------------------------------------------
# Temporary files
# -----------------------------------------------------------
tmp/
temp/
*.tmp

notes/
CLAUDE.md
custom-skills/
.claude/
.agents/
.worktrees/

# Written by packaging/build.py on every build, with absolute paths to whatever
# machine produced it. Committing it meant the repository carried one
# developer's home directory and a wheel list that went stale silently.
packaging/venvstacks.resolved.toml
