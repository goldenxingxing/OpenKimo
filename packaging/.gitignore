# Build artifacts
#
# Only what actually lands *inside* packaging/. The installers do not: both
# build scripts default --output-dir to the repo root (build.py -> ../dist,
# build_windows.py -> ../dist-win), so `dist/`, `dist-win/`, `*.dmg` and
# `*.exe` here matched nothing and a ~200 MB dist-win/ showed up untracked at
# the root. The root .gitignore covers those.
.build/
.cache/

# Generated requirements (recreated by venvstacks lock)
requirements/

# Generated wheels (rebuilt on each run)
wheels/*.whl

# macOS
.DS_Store
